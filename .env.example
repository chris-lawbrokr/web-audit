# Lawbrokr web audit: environment variables
#
# Local:   cp .env.example .env.local   then fill in the four provider keys: every audit uses real data
# Vercel:  Project → Settings → Environment Variables


# --- Filled in by Vercel when Neon and Blob are connected to the project ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BLOB_READ_WRITE_TOKEN=


# --- Provider keys (required everywhere: there is no sample-data mode) ---

# app.dataforseo.com → API Access (the API password, not the account password)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Semrush → Subscription info → API units (Standard API; bounce rate would need the Trends API)
SEMRUSH_API_KEY=

# Google Cloud → enable "PageSpeed Insights API" → Credentials → API key (its answers include Chrome's
# real-visitor data, so the separate Chrome UX Report API isn't needed)
GOOGLE_API_KEY=


# --- Settings ---

# Production only. Example: https://lawbrokr.com/audit
APP_BASE_URL=

# Where "Book a walkthrough" goes. Example: https://meetings.hubspot.com/jgutmann/discovery-call-website
NEXT_PUBLIC_BOOKING_URL=


# --- Secrets for Preview and Production. Generate each with: openssl rand -hex 32 ---
CRON_SECRET=
IP_HASH_SALT=


# --- Error tracking, Production only. Sentry → Project → Settings → Client Keys (DSN) ---
SENTRY_DSN=
